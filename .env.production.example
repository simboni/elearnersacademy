# ── eLearners Academy · Production environment ──────────────────────────
# Copy to `.env.production` (or set in your host's dashboard) and fill in.
# NEVER commit the filled-in file.

# ── Database ────────────────────────────────────────────────────────────
# SQLite on a persistent volume (Docker/VPS default — zero extra services):
DATABASE_URL="file:/data/prod.db"
# Postgres (managed DB / serverless). If you use this, also change the
# datasource provider in prisma/schema.prisma from "sqlite" to "postgresql":
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/elearners?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────
# Generate with:  node scripts/gen-secret.mjs   (or: openssl rand -base64 32)
NEXTAUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Your live URL (used for callbacks, sitemap, emails):
NEXTAUTH_URL="https://your-domain.com"

# ── AI Tutor (optional) ─────────────────────────────────────────────────
# Without a key the tutor uses a built-in domain-aware fallback.
ANTHROPIC_API_KEY=""

# ── Payments · IntaSend (optional) ──────────────────────────────────────
# Get keys at https://intasend.com (M-Pesa, card, bank for Kenya).
# Without keys, checkout runs in simulated mode (enrolls immediately).
INTASEND_PUBLISHABLE_KEY=""
INTASEND_SECRET_KEY=""
# Use "false" for live keys, "true" while testing with sandbox keys.
INTASEND_TEST_MODE="true"
