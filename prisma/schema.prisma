// eLearners Academy LMS — data model
// SQLite for zero-config local/dev. Swap datasource to Postgres for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  image         String?
  role          String    @default("STUDENT") // STUDENT | INSTRUCTOR | ADMIN
  bio           String?
  headline      String?
  country       String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // relations
  coursesTeaching   Course[]        @relation("Instructor")
  enrollments       Enrollment[]
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]
  reviews           Review[]
  wishlist          WishlistItem[]
  orders            Order[]
  certificates      Certificate[]
  notes             Note[]
  threads           Thread[]
  posts             Post[]
  notifications     Notification[]
  badges            UserBadge[]
  points            PointLog[]
  streak            Streak?
  assignmentSubs    AssignmentSubmission[]
  liveRegistrations LiveRegistration[]
  sessionsAuth      Session[]
  accounts          Account[]
  messagesSent      ChatMessage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// CATALOG: CATEGORIES, COURSES, CURRICULUM
// ============================================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  courses     Course[]
}

model Course {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  subtitle       String?
  description    String   // long, markdown-ish
  image          String?
  promoVideoUrl  String?
  level          String   @default("Beginner") // Beginner | Intermediate | Advanced | All Levels
  language       String   @default("English")
  price          Float    @default(0)
  discountPrice  Float?
  currency       String   @default("KES")
  status         String   @default("PUBLISHED") // DRAFT | PENDING | PUBLISHED | ARCHIVED
  featured       Boolean  @default(false)
  bestseller     Boolean  @default(false)
  durationLabel  String?  // e.g. "One Week"
  requirements   String?  // JSON array string
  outcomes       String?  // JSON array string ("what you'll learn")
  targetAudience String?  // JSON array string
  tags           String?  // JSON array string
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id])
  instructorId String
  instructor   User         @relation("Instructor", fields: [instructorId], references: [id])

  sections     Section[]
  enrollments  Enrollment[]
  reviews      Review[]
  wishlisted   WishlistItem[]
  certificates Certificate[]
  orderItems   OrderItem[]
  threads      Thread[]
  liveSessions LiveSession[]
  announcements Announcement[]
  assignments  Assignment[]
}

model Section {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id            String   @id @default(cuid())
  title         String
  order         Int      @default(0)
  type          String   @default("VIDEO") // VIDEO | ARTICLE | QUIZ | ASSIGNMENT | LIVE
  contentUrl    String?  // video URL
  content       String?  // article body (markdown/html)
  durationSec   Int      @default(0)
  isPreview     Boolean  @default(false)
  attachments   String?  // JSON array of {name,url}
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  progress      LessonProgress[]
  notes         Note[]
  quiz          Quiz?
}

// ============================================================
// ENROLLMENT & PROGRESS
// ============================================================

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  progressPct Float    @default(0)
  completedAt DateTime?
  lastLessonId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  positionSec Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ============================================================
// QUIZZES & ASSESSMENTS
// ============================================================

model Quiz {
  id           String   @id @default(cuid())
  lessonId     String   @unique
  title        String
  description  String?
  passingScore Int      @default(70) // percentage
  timeLimitMin Int?
  maxAttempts  Int      @default(0) // 0 = unlimited
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  order       Int      @default(0)
  type        String   @default("SINGLE") // SINGLE | MULTIPLE | TRUE_FALSE
  prompt      String
  explanation String?
  points      Int      @default(1)
  options     String   // JSON array of {id,text,correct}
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  score       Float    @default(0)
  passed      Boolean  @default(false)
  answers     String   // JSON of {questionId: [optionIds]}
  createdAt   DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// ASSIGNMENTS
// ============================================================

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String
  dueAt       DateTime?
  maxPoints   Int      @default(100)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  content      String
  fileUrl      String?
  grade        Float?
  feedback     String?
  status       String   @default("SUBMITTED") // SUBMITTED | GRADED
  createdAt    DateTime @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// CERTIFICATES
// ============================================================

model Certificate {
  id             String   @id @default(cuid())
  serial         String   @unique
  userId         String
  courseId       String
  issuedAt       DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ============================================================
// REVIEWS & WISHLIST
// ============================================================

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ============================================================
// COMMERCE: ORDERS, COUPONS
// ============================================================

model Order {
  id          String   @id @default(cuid())
  userId      String
  total       Float
  currency    String   @default("KES")
  status      String   @default("PAID") // PENDING | PAID | FAILED | REFUNDED
  method      String   @default("intasend")
  reference   String?
  couponCode  String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       OrderItem[]
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  courseId String
  price    Float
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course   Course  @relation(fields: [courseId], references: [id])
}

model Coupon {
  id           String   @id @default(cuid())
  code         String   @unique
  description  String?
  percentOff   Int?
  amountOff    Float?
  maxRedemptions Int?
  timesUsed    Int      @default(0)
  expiresAt    DateTime?
  active       Boolean  @default(true)
}

// ============================================================
// COMMUNITY: FORUMS / Q&A
// ============================================================

model Thread {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  title     String
  body      String
  pinned    Boolean  @default(false)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts     Post[]
}

model Post {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  body      String
  isAnswer  Boolean  @default(false)
  createdAt DateTime @default(now())
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// LIVE SESSIONS / WEBINARS
// ============================================================

model LiveSession {
  id          String   @id @default(cuid())
  courseId    String?
  title       String
  description String?
  startAt     DateTime
  durationMin Int      @default(60)
  joinUrl     String?
  hostName    String?
  status      String   @default("SCHEDULED") // SCHEDULED | LIVE | ENDED
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  registrations LiveRegistration[]
}

model LiveRegistration {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

// ============================================================
// GAMIFICATION: POINTS, BADGES, STREAKS
// ============================================================

model PointLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  icon        String
  tier        String   @default("bronze") // bronze | silver | gold | platinum
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Streak {
  id           String   @id @default(cuid())
  userId       String   @unique
  current      Int      @default(0)
  longest      Int      @default(0)
  lastActive   DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// NOTES, NOTIFICATIONS, ANNOUNCEMENTS, CHAT (AI tutor)
// ============================================================

model Note {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  body        String
  timestampSec Int     @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("info")
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // user | assistant
  content   String
  context   String?  // course/lesson context id
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
